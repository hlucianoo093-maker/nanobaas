NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/nanobaas.sqlite
STORAGE_PATH=./data/storage
MAX_FILE_BYTES=5242880
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
# Optional. Required to deliver password-reset and email-verification messages.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required for webhook management/delivery. Generate 32 random bytes as 64 hex characters and preserve it.
WEBHOOK_ENCRYPTION_KEY=
# Comma-separated instance administrators. Accounts must verify these email addresses before getting admin access.
PLATFORM_ADMIN_EMAILS=
