{
  "name": "nanobaas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Lightweight, multi-project Backend-as-a-Service",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "admin:dev": "vite --config apps/admin/vite.config.ts",
    "admin:build": "vite build --config apps/admin/vite.config.ts",
    "build": "npm run admin:build && tsc -p apps/api/tsconfig.json && tsc -p scripts/tsconfig.json",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx apps/api/src/db/migrate-cli.ts",
    "db:backup": "node apps/api/dist/scripts/backup.js",
    "db:verify": "node apps/api/dist/scripts/verify-backup.js",
    "db:restore": "node apps/api/dist/scripts/restore.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.4",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.4.0",
    "file-type": "^21.1.1",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^10.6.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
